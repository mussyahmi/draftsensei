rules_version = '2';

// One document per account, reachable only by that account. Nothing here is
// readable by anyone else, signed in or not.
service cloud.firestore {
  match /databases/{database}/documents {
    match /drafts/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // usage/{day} holds the shared daily ask count. Only the server touches
    // it, through the admin SDK, which these rules do not apply to; with no
    // rule here, browsers can neither read nor write it.
  }
}
